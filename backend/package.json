{
  "name": "csms-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Charging Station Management System backend",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js",
    "migrate:down": "node src/db/migrate.js down",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "create-admin": "node scripts/create-admin.js",
    "lint": "eslint ."
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "ws": "^8.18.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "supertest": "^7.3.0"
  }
}
