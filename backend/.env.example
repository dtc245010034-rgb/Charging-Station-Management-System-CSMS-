# Sao chép thành .env và điền giá trị THẬT. Không commit .env.
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://csms:<mat-khau-db>@localhost:5432/csms
# Tối thiểu 32 ký tự ngẫu nhiên, ví dụ: openssl rand -hex 32
JWT_SECRET=
# Ngưỡng khoá đăng nhập theo IP: số lần sai trong 15 phút (mặc định 20)
LOGIN_IP_MAX_FAILURES=20
# Số reverse proxy tin cậy đứng trước app (0 = bỏ qua X-Forwarded-For, dùng khi chạy trực tiếp)
TRUST_PROXY=0
# Chỉ dùng cho: npm run create-admin (mật khẩu >= 12 ký tự)
ADMIN_EMAIL=
# Nếu mật khẩu có ký tự # hoặc khoảng trắng, BỌC trong ngoặc kép, nếu không phần sau # bị coi là ghi chú và bị cắt: ADMIN_PASSWORD="Mat#Khau-12345"
ADMIN_PASSWORD=
# Khoảng nhịp tim OCPP BootNotification interval (giây), mặc định 60
OCPP_HEARTBEAT_INTERVAL=60
# Chu kỳ gửi WebSocket Ping giữ kết nối OCPP (giây), mặc định 30 (B9)
OCPP_PING_INTERVAL=30
# Giới hạn tần suất tin nhắn cho mỗi kết nối OCPP (tin/giây), mặc định 50 (B3)
OCPP_RATE_LIMIT_MAX=50
# Thời gian chờ phản hồi CALL từ trụ (giây), mặc định 30
OCPP_COMMAND_TIMEOUT_SECONDS=30
# Cửa sổ gộp các sự kiện chia lại công suất tại cùng một trạm (mili giây)
POWER_REBALANCE_MIN_INTERVAL_MS=2000
# Số giây không nhận tin từ trụ trước khi phiên sạc bị đánh dấu bất thường (mặc định 6 giờ)
SESSION_ABNORMAL_AFTER_SECONDS=21600
# Số phút tối đa chờ đầu nối rời Finishing/SuspendedEV trước khi chốt hóa đơn
IDLE_MAX_WAIT_MIN=60
# Thời gian giữ thêm sau arriveInMinutes khi đặt chỗ đầu nối
RESERVATION_HOLD_MIN=15
# Chu kỳ job tìm phiên cần lập hóa đơn và thử lại lỗi
BILLING_JOB_INTERVAL_MS=30000
# Chu kỳ kiểm định số dư ví và sổ cái
WALLET_AUDIT_INTERVAL_MS=300000
# Ngưỡng tiền được chấp nhận khi đối soát (đồng; mặc định 0)
RECON_TOLERANCE_DONG=0
# Ngưỡng số dư tối thiểu (đồng); để trống sẽ lấy 5 kWh theo giá kWh cao nhất đang hiệu lực
WALLET_MIN_BALANCE_DONG=
# Khử trùng lỗi đầu nối: bỏ qua lỗi y hệt đã ghi trong N giây gần nhất, 0 = tắt (mặc định 60)
OCPP_ERROR_DEDUP_SECONDS=60
OCPP_MESSAGE_RETENTION_DAYS=7
OCPP_DUPLICATE_REPLAY_WINDOW_SECONDS=600
# Giây tối đa một truy vấn của handler OCPP chờ khoá hàng trước khi trả InternalError
OCPP_LOCK_TIMEOUT_SECONDS=5
# Giây tối đa chờ một truy vấn PostgreSQL trả kết quả (0 = không giới hạn)
DB_QUERY_TIMEOUT_SECONDS=30
# Số luồng SSE tối đa mỗi tài khoản; luồng mở thêm sẽ đóng luồng cũ nhất
SSE_MAX_CONNECTIONS_PER_USER=5
# Giới hạn tần suất (trong bộ nhớ, một tiến trình): check-code/phút/tài khoản, lần dò email trùng khi đăng ký/giờ/IP,
# bắt tay OCPP/10 giây/(IP, mã trụ), dòng ACCESS_DENIED ghi vào audit_logs/phút/tài khoản
CHECK_CODE_RATE_LIMIT_PER_MINUTE=30
REGISTER_CONFLICT_LIMIT_PER_HOUR=5
OCPP_HANDSHAKE_LIMIT_PER_10S=5
AUDIT_DENIED_LIMIT_PER_MINUTE=20
# Cổng thanh toán sandbox (1 = bật bộ giả lập /sandbox-gateway)
SANDBOX_GATEWAY=0
# Giá trị giả để chạy sandbox cục bộ; thay bằng khoá ngẫu nhiên riêng (>= 32 ký tự)
PAYMENT_WEBHOOK_SECRET=FAKE-EXAMPLE-ONLY-replace-with-random-secret-32chars
# Địa chỉ nội bộ để bộ giả lập gọi webhook
INTERNAL_BASE_URL=http://127.0.0.1:3000
# Chỉ có 'log'; SMTP chưa được triển khai
EMAIL_TRANSPORT=log
# Mật khẩu cho backup mã hoá; lấy từ kho bí mật, không ghi giá trị thật vào repo
BACKUP_PASSPHRASE=
# Thư mục sao lưu (ngoài repo); mặc định ~/csms-backups
BACKUP_DIR=
# Số bản sao lưu giữ lại
KEEP=7
# Chỉ bật tạm thời trên máy dev nếu cần sao lưu SQL rõ; tuyệt đối không dùng staging/production
# BACKUP_ALLOW_PLAINTEXT=1

# Chặng 9: Chu kỳ quét hạn mức công suất theo khung giờ (ms), mặc định 15000 (15s)
POWER_SCHEDULE_TICK_MS=15000
# Chặng 9: Chu kỳ quét đặt chỗ quá hạn (ms), mặc định 15000 (15s)
RESERVATION_EXPIRY_JOB_MS=15000
# Chặng 9: Mật khẩu tài khoản dựng sẵn khi chạy `npm run seed-demo` (cần ALLOW_DEMO_SEED=1; tối thiểu 12 ký tự)
# DEMO_PASSWORD=DemoSecretPass123!
