# Sao chép thành .env và điền giá trị THẬT. Không commit .env.
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://csms:<mat-khau-db>@localhost:5432/csms
# Tối thiểu 32 ký tự ngẫu nhiên, ví dụ: openssl rand -hex 32
JWT_SECRET=
# Ngưỡng khoá đăng nhập theo IP: số lần sai trong 15 phút (mặc định 20)
LOGIN_IP_MAX_FAILURES=20
# Số reverse proxy tin cậy đứng trước app (0 = bỏ qua X-Forwarded-For, dùng khi chạy trực tiếp)
TRUST_PROXY=0
# Chỉ dùng cho: npm run create-admin (mật khẩu >= 12 ký tự)
ADMIN_EMAIL=
# Nếu mật khẩu có ký tự # hoặc khoảng trắng, BỌC trong ngoặc kép, nếu không phần sau # bị coi là ghi chú và bị cắt: ADMIN_PASSWORD="Mat#Khau-12345"
ADMIN_PASSWORD=
# Khoảng nhịp tim OCPP BootNotification interval (giây), mặc định 60
OCPP_HEARTBEAT_INTERVAL=60
# Chu kỳ gửi WebSocket Ping giữ kết nối OCPP (giây), mặc định 30 (B9)
OCPP_PING_INTERVAL=30
# Giới hạn tần suất tin nhắn cho mỗi kết nối OCPP (tin/giây), mặc định 50 (B3)
OCPP_RATE_LIMIT_MAX=50
