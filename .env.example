# Copy to .env and replace with your real values.
# This file is a sample only. DO NOT commit the real .env file.

# PostgreSQL settings used by Docker Compose
POSTGRES_DB=csms
POSTGRES_USER=csms
POSTGRES_PASSWORD=ChangeThisStrongPassword123!
POSTGRES_PORT=5432

# App settings used by backend container
PORT=3000
APP_PORT=3000
JWT_SECRET=replace_with_32_plus_char_random_secret
APP_ORIGIN=http://localhost:3000
TRUST_PROXY=0

# Optional: if you use the test DB container manually
# POSTGRES_TEST_DB=csms_test
# POSTGRES_TEST_PORT=5433
